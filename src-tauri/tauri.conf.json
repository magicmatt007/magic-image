{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magic-image",
  "version": "../package.json",
  "identifier": "io.github.magicmatt007.imagemagic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "magic-image",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "magicmatt007",
    "shortDescription": "Lightweight image annotator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "name": "PNG image",
        "role": "Editor"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "name": "JPEG image",
        "role": "Editor"
      },
      {
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "name": "WebP image",
        "role": "Editor"
      },
      {
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "name": "GIF image",
        "role": "Editor"
      },
      {
        "ext": [
          "bmp"
        ],
        "mimeType": "image/bmp",
        "name": "BMP image",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MkExMkM5NTlBREIyMDQKUldRRXNxMVp5UklxVnExNzVrYXM1S244TFJZMkkwbW04RTlNZ29INkF3T05TYzZ2SU1PN2k2SVUK",
      "endpoints": [
        "https://github.com/magicmatt007/magic-image/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
